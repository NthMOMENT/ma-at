# Arbitrum Sepolia RPCs — get from Alchemy dashboard
# Three separate Alchemy app keys, rotated round-robin (not always URL_1
# first) by createRotatingHttpTransport (orchestrator/src/rpc_rotation.ts,
# used by listener.ts and arbitrum_settlement.ts) and by the equivalent
# file-backed helper in zk/script (rpc_rotation.rs, used by header_check.rs
# and prove.rs) — one key hitting its monthly cap gets skipped for
# RPC_COOLDOWN_SEC instead of taking the whole pipeline down.
# Format: https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
ALCHEMY_RPC_URL_1=
ALCHEMY_RPC_URL_2=
ALCHEMY_RPC_URL_3=

# RPC key rotation (Gate rpc-rotation): how long, in seconds, a key that just
# hit a monthly-capacity/429 error is skipped before being tried again.
# Default 1800 (30 min). Shared by both the orchestrator's in-memory tracker
# and zk/script's file-backed one (RPC_HEALTH_FILE_PATH below).
RPC_COOLDOWN_SEC=1800
# zk/script only: where prove.rs/header_check.rs persist which RPC URL is
# cooling down, across separate process runs (each is a fresh process, so
# this can't just live in memory like the orchestrator's tracker does).
# Default ".rpc_health.json", relative to cwd (zk/ when spawned normally by
# prover_pipeline.ts). Missing or corrupted file => treated as "no info, try
# URL_1 first", never a crash.
RPC_HEALTH_FILE_PATH=

# Gate 5D-fix: Robinhood is fully disabled (no connection attempt, no
# watcher) by default for the MVP — Arbitrum only. Set to "true" to re-enable.
ENABLE_ROBINHOOD=

# Robinhood Chain Testnet RPC (public endpoint — no key needed). Only read if
# ENABLE_ROBINHOOD=true.
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Optional Alchemy-backed fallback for Robinhood Testnet, used if the public
# endpoint above is unavailable. Format: https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY_HERE
ROBINHOOD_ALCHEMY_RPC_URL=

# IntentManager contract addresses — each EVM chain has its own deployment,
# never shared. Testnet addresses, not secrets.
# ARBITRUM_INTENT_MANAGER_ADDRESS is REQUIRED (Phase 7): the orchestrator
# (listener.ts) and both zk/script host binaries (prove.rs, header_check.rs)
# fail fast at startup if it's unset — there's no hardcoded fallback anymore.
ARBITRUM_INTENT_MANAGER_ADDRESS=
ROBINHOOD_INTENT_MANAGER_ADDRESS=0xcA6bf2D574209D49515a9Eeb61E27924edE28860

# Arbitrum Sepolia signing keys (Phase 7) — REQUIRED for the postCollateral /
# confirmSettlement / slashSolver settlement sequence. Never commit real
# values here.
# Each solver key's address must be approved via IntentManager v2's setSolver
# (owner-only) before postCollateral will succeed for it — an unapproved key
# is logged as a warning at boot, not fatal (see checkSolverApprovals).
# ARBITRUM_ORCHESTRATOR_PRIVATE_KEY's address must be the address currently
# set as IntentManager v2's orchestrator role (owner-rotatable via
# setOrchestrator) — confirmSettlement/slashSolver revert otherwise.
#
# Week 3 design (solver credit scoring), Phase 1: multiple solver keys are
# supported via indexed vars, mirroring ALCHEMY_RPC_URL_1/2/3's convention —
# ARBITRUM_SOLVER_PRIVATE_KEY_1, _2, ... _N. If none of the numbered vars are
# set, the legacy single ARBITRUM_SOLVER_PRIVATE_KEY below is treated as key
# 1, so an existing single-key .env needs no changes. Duplicate addresses
# across keys are rejected at boot.
ARBITRUM_SOLVER_PRIVATE_KEY_1=
ARBITRUM_SOLVER_PRIVATE_KEY_2=
ARBITRUM_SOLVER_PRIVATE_KEY=
ARBITRUM_ORCHESTRATOR_PRIVATE_KEY=

# Arbitrum settlement sequence tuning (Phase 7B) — all optional, sane defaults shown.
# Caps a single intent's native-ETH amount this orchestrator will post
# collateral for. Wei, default 0.01 ETH.
MAX_TRANSFER_WEI=10000000000000000
# How long before an intent's expiry the sequence stops trying (gate check,
# and the Solana-payout retry deadline). Seconds, default 600 (10 min).
DELIVERY_MARGIN_SEC=600
# Headroom above the exact 150% collateral requirement, so postCollateral's
# own gas cost can't turn "solver can afford collateral" into "ran out of
# ETH mid-tx". Wei, default 0.001 ETH.
ARBITRUM_GAS_BUFFER_WEI=1000000000000000
# How long to wait between Solana-payout retry attempts after a failure.
# Milliseconds, default 30000 (30s).
SOLANA_PAYOUT_RETRY_INTERVAL_MS=30000
# confirmSettlement retry backoff schedule (comma-separated milliseconds),
# default "60000,300000,900000,1800000" = 1, 5, 15, 30 min, then the last
# value (30 min) repeats for every attempt after that.
CONFIRM_RETRY_BACKOFF_MS=60000,300000,900000,1800000
# How long past an intent's expiry confirmSettlement keeps retrying before
# giving up. Seconds, default 72000 (20h) — MUST stay below IntentManager
# v2's 24h claimRefund grace period (orchestrator fails fast at boot if not).
CONFIRM_RETRY_MAX_SEC_AFTER_EXPIRY=72000
# How often to check "awaiting_expiry_slash" entries against the wall clock.
# Milliseconds, default 60000 (1 min).
SLASH_POLL_INTERVAL_MS=60000
# Where the Arbitrum-side settlement ledger (postCollateral/confirmSettlement/
# slashSolver crash-safety) is persisted. Defaults next to settled_intents.json.
ARBITRUM_LEDGER_PATH=

# TRON Nile Testnet — IntentManager contract + TronGrid polling (tron_listener.ts)
# TronGrid splits networks by subdomain; Nile Testnet lives at nile.trongrid.io
# (NOT api.trongrid.io, which is mainnet). Override only if proxying.
TRON_API_BASE_URL=https://nile.trongrid.io
TRON_INTENT_MANAGER_ADDRESS=TBxLkBxy4sFnztxKnYbTGHd47oTf4GxLNi
# Optional — TronGrid works keyless at low rate limits. Same fallback pattern
# as ALCHEMY_RPC_URL_1/2: first key tried, second used if the first fails.
TRONGRID_API_KEY_1=
TRONGRID_API_KEY_2=
TRON_POLL_INTERVAL_MS=3000

# Deployer key for deploy_tron.js — funds Nile testnet gas and becomes
# orchestrator/treasury/owner on the deployed IntentManager. Testnet only.
TRON_PRIVATE_KEY=

# Week 3 design (solver credit scoring), Phase 2: track record and tiers
# (orchestrator/src/solver_stats.ts). Pure functions only — nothing wired
# into routing yet (Phase 3).
# Where the terminal-intent cache (Settled/Slashed/Refunded/Expired reads,
# never Pending) is persisted. Gitignored. Defaults next to
# arbitrum_settled_intents.json.
SOLVER_STATS_CACHE_PATH=
# Promote a solver one tier (toward 1, best) once resolved (settled+slashed,
# after exclusions) reaches this count AND successRate reaches this fraction.
SOLVER_PROMOTE_MIN_RESOLVED=10
SOLVER_PROMOTE_MIN_SUCCESS=0.95
# Demote a solver one tier (toward 3, probation) once resolved reaches this
# count AND successRate falls below this fraction.
SOLVER_DEMOTE_MIN_RESOLVED=3
SOLVER_DEMOTE_MAX_SUCCESS=0.80
# tierCapWei (not used anywhere yet — Phase 3): cap on a single transfer as a
# percentage of MAX_TRANSFER_WEI, per tier.
SOLVER_TIER_CAP_PCT_1=100
SOLVER_TIER_CAP_PCT_2=30
SOLVER_TIER_CAP_PCT_3=5
